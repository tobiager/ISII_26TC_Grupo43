classDiagram
direction TB

%% ═══════════════════════════════════════════════════════════════════
%% CAPA DE APLICACIÓN - CONTROLLERS
%% ═══════════════════════════════════════════════════════════════════

class PacienteController {
  -PacienteService pacienteService
  
  +obtenerTodosLosPacientes() List~PacienteResponseDTO~
  +obtenerPacientesEliminados() List~PacienteResponseDTO~
  +obtenerPacientePorId(Integer) PacienteResponseDTO
  +crearPaciente(PacienteRequestDTO) PacienteResponseDTO
  +actualizarPaciente(Integer, PacienteRequestDTO) PacienteResponseDTO
  +eliminarPaciente(Integer) void
  +restaurarPaciente(Integer) void
  +existeDni(Integer, Integer) boolean
  +existeAfiliado(...) boolean
}

class AuthController {
  -AuthService authService
  
  +login(LoginRequestDTO) LoginResponseDTO
  +register(RegisterRequestDTO) LoginResponseDTO
  +me(String) UsuarioAuthDTO
  +crearInvitacion(InvitacionRequestDTO, String) InvitacionResponseDTO
  +listarInvitaciones() List~InvitacionResponseDTO~
  +validarToken(String) ValidarTokenResponseDTO
}

class AdminController {
  -AdminService adminService
  
  +listarUsuarios() List~AdminUsuarioDTO~
  +cambiarRol(Integer, CambiarRolRequestDTO) void
  +resetPassword(Integer) ResetPasswordResponseDTO
}

class HistorialController {
  -HistorialService historialService
  -UsuarioRepository usuarioRepository
  
  +listarTiposProcedimiento() List~TipoProcedimientoDTO~
  +obtenerPorPaciente(Integer) HistorialDetalleResponseDTO
  +registrarEvento(Integer, RegistroClinicoRequestDTO, Authentication) void
}

class HabitacionController {
  -HabitacionService habitacionService
  -UsuarioRepository usuarioRepository
  
  +listarHabitaciones() List~HabitacionResponseDTO~
  +internar(InternacionRequestDTO) void
  +trasladar(Integer, TrasladoRequestDTO) void
  +egresar(Integer, EgresoRequestDTO) void
}

class PerfilController {
  -PerfilService perfilService
  
  +obtenerPerfil(String) PerfilResponseDTO
  +cambiarDatosBasicos(String, CambiarDatosBasicosRequestDTO) void
  +cambiarPassword(String, CambiarPasswordRequestDTO) void
  +cambiarEmail(String, CambiarEmailRequestDTO) void
}

class LocalidadController {
  -LocalidadRepository localidadRepository
  
  +listarLocalidades() List~Localidad~
}

class ObraSocialController {
  -ObraSocialRepository obraSocialRepository
  
  +listarObrasSociales() List~ObraSocial~
}

class ProvinciaController {
  -ProvinciaRepository provinciaRepository
  
  +listarProvincias() List~Provincia~
}

class UsuarioController {
  -UsuarioRepository usuarioRepository
  
  +obtenerUsuario(Integer) Usuario
}

%% ═══════════════════════════════════════════════════════════════════
%% CAPA DE APLICACIÓN - SERVICIOS (INTERFACES)
%% ═══════════════════════════════════════════════════════════════════

class PacienteService {
  <<interface>>
  +obtenerTodosLosPacientes() List~PacienteResponseDTO~
  +obtenerPacientesEliminados() List~PacienteResponseDTO~
  +obtenerPacientePorId(Integer) PacienteResponseDTO
  +crearPaciente(PacienteRequestDTO) PacienteResponseDTO
  +actualizarPaciente(Integer, PacienteRequestDTO) PacienteResponseDTO
  +eliminarPaciente(Integer) void
  +restaurarPaciente(Integer) void
  +existeDni(Integer, Integer) boolean
  +existeAfiliado(...) boolean
}

class AuthService {
  <<interface>>
  +login(LoginRequestDTO) LoginResponseDTO
  +register(RegisterRequestDTO) LoginResponseDTO
  +me(String) UsuarioAuthDTO
  +crearInvitacion(InvitacionRequestDTO, String) InvitacionResponseDTO
  +listarInvitaciones() List~InvitacionResponseDTO~
  +validarToken(String) ValidarTokenResponseDTO
}

class AdminService {
  <<interface>>
  +listarUsuarios() List~AdminUsuarioDTO~
  +cambiarRol(Integer, CambiarRolRequestDTO) void
  +resetPassword(Integer) ResetPasswordResponseDTO
}

class HistorialService {
  <<interface>>
  +listarTiposProcedimiento() List~TipoProcedimientoDTO~
  +obtenerPorPaciente(Integer) HistorialDetalleResponseDTO
  +registrarEvento(Integer, RegistroClinicoRequestDTO, Integer) void
}

class HabitacionService {
  <<interface>>
  +listarHabitaciones() List~HabitacionResponseDTO~
  +internar(InternacionRequestDTO) void
  +trasladar(Integer, TrasladoRequestDTO) void
  +egresar(Integer, EgresoRequestDTO) void
}

class PerfilService {
  <<interface>>
  +obtenerPerfil(String) PerfilResponseDTO
  +cambiarDatosBasicos(String, CambiarDatosBasicosRequestDTO) void
  +cambiarPassword(String, CambiarPasswordRequestDTO) void
  +cambiarEmail(String, CambiarEmailRequestDTO) void
}

%% ═══════════════════════════════════════════════════════════════════
%% CAPA DE APLICACIÓN - IMPLEMENTACIONES DE SERVICIOS
%% ═══════════════════════════════════════════════════════════════════

class PacienteServiceImpl {
  -PacienteRepository pacienteRepository
  -ObraSocialRepository obraSocialRepository
  -AfiliacionObraSocialRepository afiliacionRepository
  -TelefonoRepository telefonoRepository
  -AlergiaRepository alergiaRepository
  -EnfermedadCronicaRepository enfermedadCronicaRepository
  -AntecedenteFamiliarRepository antecedenteFamiliarRepository
  -ContactoEmergenciaRepository contactoEmergenciaRepository
  -LocalidadRepository localidadRepository
  -HistorialMedicoRepository historialMedicoRepository
  
  -obtenerPacienteActivo(Integer) Paciente
  -validarAfiliadoUnico(PacienteRequestDTO, Integer) void
  -validarTelefonosSolicitud(...) void
  -resolveAfiliacion(...) AfiliacionObraSocial
  -resolveLocalidad(Integer) Localidad
  -mapearPacienteADTO(Paciente) PacienteResponseDTO
}

class AuthServiceImpl {
  -UsuarioRepository usuarioRepository
  -PersonaRepository personaRepository
  -RolRepository rolRepository
  -InvitacionRegistroRepository invitacionRepository
  -PasswordEncoder passwordEncoder
  -JwtUtil jwtUtil
  
  -validarInvitacion(String) InvitacionRegistro
  -hashPassword(String) String
  -generarToken(Usuario) String
  -verificarToken(String) String
}

class AdminServiceImpl {
  -UsuarioRepository usuarioRepository
  -RolRepository rolRepository
  -PasswordEncoder passwordEncoder
  
  -validarRol(Integer) Rol
  -generarPasswordTemporal() String
}

class HistorialServiceImpl {
  -PacienteRepository pacienteRepository
  -HistorialMedicoRepository historialRepository
  -RegistroClinicoRepository registroRepository
  -InternacionRepository internacionRepository
  -TipoProcedimientoRepository tipoRepository
  -UsuarioRepository usuarioRepository
  
  -obtenerOCrearHistorial(Integer) HistorialMedico
  -mapearADTO(...) HistorialDetalleResponseDTO
}

class HabitacionServiceImpl {
  -HabitacionInternacionRepository habitacionRepository
  -InternacionRepository internacionRepository
  -PacienteRepository pacienteRepository
  -HistorialMedicoRepository historialRepository
  -RegistroClinicoRepository registroRepository
  -TipoProcedimientoRepository tipoRepository
  -UsuarioRepository usuarioRepository
  
  -validarHabitacionDisponible(Integer) void
  -registrarMovimiento(...) void
}

class PerfilServiceImpl {
  -UsuarioRepository usuarioRepository
  -PasswordEncoder passwordEncoder
  
  -obtenerUsuarioActivo(String) Usuario
  -validarPasswordActual(Usuario, String) void
}

%% ═══════════════════════════════════════════════════════════════════
%% CAPA DE PERSISTENCIA - REPOSITORIOS
%% ═══════════════════════════════════════════════════════════════════

class PacienteRepository {
  <<interface>>
  +encontrarPacienteActivoPorId(Integer) Optional~Paciente~
  +existePorDni(Integer) boolean
  +existePorDniYNoIdPaciente(Integer,Integer) boolean
  +existePorAfiliacionYObraSocialId(String,Integer,Integer) boolean
  +existePorAfiliacionYObraSocialNombre(String,String,Integer) boolean
  +encontrarTodosLosPacientesActivosConDetalles() List~PacienteResumenProjection~
  +encontrarTodosLosPacientesEliminadosConDetalles() List~PacienteResumenProjection~
  +buscarPorDniONombre(String) List~Paciente~
}

class UsuarioRepository {
  <<interface>>
  +encontrarPorIdUsuarioActivo(Integer) Optional~Usuario~
  +encontrarPrimerUsuarioActivo() Optional~Usuario~
  +findByEmail(String) Optional~Usuario~
  +findByEmailActivo(String) Optional~Usuario~
  +existsByEmail(String) boolean
  +findAllOrderById() List~Usuario~
  +contarAdministradoresActivos() long
}

class RolRepository {
  <<interface>>
  +findByNombreRol(String) Optional~Rol~
}

class PersonaRepository {
  <<interface>>
  +findById(Integer) Optional~Persona~
}

class ObraSocialRepository {
  <<interface>>
  +findAll() List~ObraSocial~
  +findByNombre(String) Optional~ObraSocial~
}

class AfiliacionObraSocialRepository {
  <<interface>>
  +findById(Integer) Optional~AfiliacionObraSocial~
  +findByNumeroAfiliado(String) Optional~AfiliacionObraSocial~
}

class LocalidadRepository {
  <<interface>>
  +findAll() List~Localidad~
  +findById(Integer) Optional~Localidad~
}

class ProvinciaRepository {
  <<interface>>
  +findAll() List~Provincia~
}

class TelefonoRepository {
  <<interface>>
  +findByNumeroDuplicado(String) Optional~Telefono~
  +deleteByPaciente(Paciente) void
}

class AlergiaRepository {
  <<interface>>
  +findByNombre(String) Optional~Alergia~
}

class EnfermedadCronicaRepository {
  <<interface>>
  +findByNombre(String) Optional~EnfermedadCronica~
}

class AntecedenteFamiliarRepository {
  <<interface>>
  +findByNombre(String) Optional~AntecedenteFamiliar~
}

class ContactoEmergenciaRepository {
  <<interface>>
  +deleteByPaciente(Paciente) void
}

class HistorialMedicoRepository {
  <<interface>>
  +findByPaciente(Paciente) Optional~HistorialMedico~
}

class RegistroClinicoRepository {
  <<interface>>
  +findByHistorialOrderByFechaRegistro(...) List~RegistroClinico~
}

class InternacionRepository {
  <<interface>>
  +findByHistorial(HistorialMedico) List~Internacion~
  +findActivasByHabitacion(HabitacionInternacion) List~Internacion~
}

class HabitacionInternacionRepository {
  <<interface>>
  +findByEstadoHabitacion(String) List~HabitacionInternacion~
  +findAllOrderByNumero() List~HabitacionInternacion~
}

class InvitacionRegistroRepository {
  <<interface>>
  +findByToken(String) Optional~InvitacionRegistro~
  +findByEmailAndDeletedAtIsNull(String) Optional~InvitacionRegistro~
  +findAllActivas() List~InvitacionRegistro~
}

class TipoProcedimientoRepository {
  <<interface>>
  +findAll() List~TipoProcedimiento~
}

%% ═══════════════════════════════════════════════════════════════════
%% RELACIONES DE APLICACIÓN
%% ═══════════════════════════════════════════════════════════════════

%% Controllers → Services
PacienteController --> PacienteService
AuthController --> AuthService
AdminController --> AdminService
HistorialController --> HistorialService
HabitacionController --> HabitacionService
PerfilController --> PerfilService
LocalidadController --> LocalidadRepository
ObraSocialController --> ObraSocialRepository
ProvinciaController --> ProvinciaRepository
UsuarioController --> UsuarioRepository

%% ServiceImpl implements Service
PacienteServiceImpl ..|> PacienteService
AuthServiceImpl ..|> AuthService
AdminServiceImpl ..|> AdminService
HistorialServiceImpl ..|> HistorialService
HabitacionServiceImpl ..|> HabitacionService
PerfilServiceImpl ..|> PerfilService

%% ServiceImpl → Repositories
PacienteServiceImpl --> PacienteRepository
PacienteServiceImpl --> ObraSocialRepository
PacienteServiceImpl --> AfiliacionObraSocialRepository
PacienteServiceImpl --> TelefonoRepository
PacienteServiceImpl --> AlergiaRepository
PacienteServiceImpl --> EnfermedadCronicaRepository
PacienteServiceImpl --> AntecedenteFamiliarRepository
PacienteServiceImpl --> ContactoEmergenciaRepository
PacienteServiceImpl --> LocalidadRepository
PacienteServiceImpl --> HistorialMedicoRepository

AuthServiceImpl --> UsuarioRepository
AuthServiceImpl --> PersonaRepository
AuthServiceImpl --> RolRepository
AuthServiceImpl --> InvitacionRegistroRepository

AdminServiceImpl --> UsuarioRepository
AdminServiceImpl --> RolRepository

HistorialServiceImpl --> PacienteRepository
HistorialServiceImpl --> HistorialMedicoRepository
HistorialServiceImpl --> RegistroClinicoRepository
HistorialServiceImpl --> InternacionRepository
HistorialServiceImpl --> TipoProcedimientoRepository
HistorialServiceImpl --> UsuarioRepository

HabitacionServiceImpl --> HabitacionInternacionRepository
HabitacionServiceImpl --> InternacionRepository
HabitacionServiceImpl --> PacienteRepository
HabitacionServiceImpl --> HistorialMedicoRepository
HabitacionServiceImpl --> RegistroClinicoRepository
HabitacionServiceImpl --> TipoProcedimientoRepository
HabitacionServiceImpl --> UsuarioRepository

PerfilServiceImpl --> UsuarioRepository
